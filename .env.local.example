# Copier ce fichier en ".env.local" et remplir les valeurs.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : utilisée seulement côté serveur, ne jamais la partager.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Envoi des courriels (SMTP) ---
# Exemple Gmail : activer la validation en 2 étapes puis créer un "mot de passe d'application".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gkserviceauto@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="GK Service Auto <gkserviceauto@gmail.com>"

# Optionnel : adresse qui reçoit une copie de chaque rapport envoyé
# et les réponses des clients aux soumissions (sinon SMTP_USER).
EMAIL_COPIE=

# Optionnel : adresse publique de l'app, utilisée pour le lien de soumission dans les courriels.
# Ex. : https://gk-service-auto.vercel.app (par défaut : l'adresse d'où la requête est faite).
APP_URL=
